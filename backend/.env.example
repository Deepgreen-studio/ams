APP_NAME="AMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://amsapi.eh.studio
FRONTEND_URL=https://ams.eh.studio
CMS_SITE_URL=https://ams.eh.studio
CMS_CONTENT_PATH_PATTERN=/content/{type}/{slug}
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ams
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.eh.studio
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mamp_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ams.eh.studio"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=ams.eh.studio,amsapi.eh.studio,easycare.eh.studio,localhost,localhost:5173,localhost:5174,localhost:5175,localhost:5176,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:5175,127.0.0.1:5176

CORS_ALLOWED_ORIGINS=https://ams.eh.studio,https://easycare.eh.studio,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176
CORS_ALLOWED_ORIGIN_PATTERNS='#^https://([a-z0-9-]+\.)?eh\.studio$#,#^https?://(localhost|127\.0\.0\.1)(:\d+)?$#'
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=0

# Media / audit (architecture ready)
FILESYSTEM_AVATAR_DISK=public
FILESYSTEM_COMPANY_MEDIA_DISK=public
FILESYSTEM_MEDIA_LIBRARY_DISK=public
FILESYSTEM_CUSTOMER_DOCUMENTS_DISK=public
AUDIT_LOG_API_REQUESTS=true
AUDIT_LOG_EXCEPTIONS=true

# Billing / subscriptions (Stripe architecture-ready; default is manual)
BILLING_PROVIDER=manual
BILLING_CURRENCY=USD
BILLING_RENEWAL_REMINDER_DAYS=14
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# EasyCare test host
EASYCARE_API_BASE_URL=https://easycare.eh.studio
EASYCARE_SUPPORT_REPLY_URL=https://easycare.eh.studio/api/v1/ams/support-replies
EASYCARE_API_TOKEN=
EASYCARE_AMS_WEBHOOK_SECRET=easycare-ams-secret

# AI providers (optional — prefer AI Settings UI or: php artisan ai:use-gemini --key=...)
AI_DEFAULT_DRIVER=null
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
