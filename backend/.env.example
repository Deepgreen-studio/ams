APP_NAME="AMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
CMS_SITE_URL=http://localhost:5173
CMS_CONTENT_PATH_PATTERN=/content/{type}/{slug}
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ams
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mamp_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ams.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=0

# Media / audit (architecture ready)
FILESYSTEM_AVATAR_DISK=public
FILESYSTEM_COMPANY_MEDIA_DISK=public
FILESYSTEM_MEDIA_LIBRARY_DISK=public
FILESYSTEM_CUSTOMER_DOCUMENTS_DISK=public
AUDIT_LOG_API_REQUESTS=true
AUDIT_LOG_EXCEPTIONS=true

# Billing / subscriptions (Stripe architecture-ready; default is manual)
BILLING_PROVIDER=manual
BILLING_CURRENCY=USD
BILLING_RENEWAL_REMINDER_DAYS=14
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# AI providers (optional — prefer AI Settings UI or: php artisan ai:use-gemini --key=...)
AI_DEFAULT_DRIVER=null
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
