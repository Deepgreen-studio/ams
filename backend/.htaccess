<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route all traffic through Laravel's public front controller.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

Options -Indexes

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.env.*|artisan|phpunit\.xml.*|phpstan\.neon.*|pint\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
