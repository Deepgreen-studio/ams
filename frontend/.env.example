VITE_APP_NAME=AMS

# Hosts
# Frontend SPA: https://ams.eh.studio
# Backend API:  https://amsapi.eh.studio
# EasyCare:     https://easycare.eh.studio

# Direct calls to the remote API (visible in the browser Network tab).
# Leave empty in development to use the Vite proxy (same-origin /sanctum + /api).
# Production builds use .env.production (VITE_API_BASE_URL=https://amsapi.eh.studio).
# Remote API auth is Bearer-token based; the client skips /sanctum/csrf-cookie.
VITE_API_BASE_URL=

# Used only by Vite dev server proxy when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=https://amsapi.eh.studio
