VITE_APP_NAME=AMS

# Leave empty to use Vite proxy (recommended for local development).
# For production builds, set to your API origin including /api/v1, e.g.:
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=

# Used only by Vite dev server proxy when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=http://127.0.0.1:8000
